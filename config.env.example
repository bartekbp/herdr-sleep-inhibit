# sleep-inhibit tunables. Copied to
# ~/.config/herdr/plugins/config/sleep-inhibit/config.env on install; edit there.
# Sourced by inhibit.sh, so plain POSIX sh assignments only.

# Seconds between agent-state polls.
POLL_SECONDS=10

# Consecutive idle polls before a hold is released. Agents dip out of "working"
# for a few seconds between turns; releasing on every dip re-exposes the machine
# to an idle-suspend timer that has already expired.
IDLE_GRACE=6

# 1 also inhibits idle actions, which stops screen blank and lock. Off by
# default: the screen should still lock on its normal timer while agents work.
INHIBIT_IDLE=0

# 1 also blocks suspend-on-lid-close. Off by default: closing the lid is an
# explicit request to suspend, and blocking it can overheat a laptop in a bag.
INHIBIT_LID=0

# Minutes of continuous hold after which the daemon gives up, until agents next
# report idle. Backstop against an agent stuck reporting "working" forever.
# 0 disables the backstop.
MAX_HOLD_MINUTES=720
